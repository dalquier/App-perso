{
  "manifest_version": 3,
  "name": "Safari Manager",
  "version": "1.0.0",
  "description": "Inventorier, rechercher et fermer prudemment les onglets Safari.",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "512": "images/icon.svg"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Safari Manager"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
