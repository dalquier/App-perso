# Fictitious local values only. Never commit a populated .env file.
NODE_ENV=development
DEVELOPEROS_ALLOWED_ORIGIN=http://localhost:5173
PORT=3000

# Optional bounded HTTP limits (defaults shown).
DEVELOPEROS_MAX_REQUEST_BYTES=1048576
DEVELOPEROS_HEADERS_TIMEOUT_MS=10000
DEVELOPEROS_REQUEST_TIMEOUT_MS=15000
DEVELOPEROS_KEEP_ALIVE_TIMEOUT_MS=5000
DEVELOPEROS_GRACEFUL_SHUTDOWN_MS=10000

# OPENAI_API_KEY is intentionally not needed by the B1 HTTP server.
# DATABASE_URL belongs to B2 and is intentionally absent.
