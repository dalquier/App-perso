# Fictitious local values only. Never commit a populated .env file.
NODE_ENV=development
OPENAI_API_KEY=replace-with-a-server-only-secret
DATABASE_URL=postgresql://user:password@localhost:5432/developeros
DEVELOPEROS_ALLOWED_ORIGIN=http://localhost:5173

# Optional bounded limits (defaults shown).
DEVELOPEROS_MAX_REQUEST_BYTES=1048576
DEVELOPEROS_MAX_PROMPT_CHARACTERS=200000
DEVELOPEROS_MAX_OUTPUT_TOKENS=8192
DEVELOPEROS_MAX_API_CONCURRENCY=2
DEVELOPEROS_OPENAI_TIMEOUT_MS=60000
