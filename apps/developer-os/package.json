{
  "name": "developeros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run icons:generate && vite --host 0.0.0.0",
    "build": "npm run icons:generate && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run src/domain",
    "test:components": "vitest run src/components src/pages",
    "test:repository": "vitest run src/data",
    "test:server": "vitest run server",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:components && npm run test:repository && npm run test:server && npm run test:pwa && npm run build",
    "test:pwa": "npm run icons:generate && vitest run tests/pwa",
    "playwright:install": "playwright install --with-deps chromium",
    "icons:generate": "node scripts/generate-icons.mjs",
    "server:start": "tsx server/http/server.ts"
  },
  "dependencies": {
    "fastify": "^5.11.2",
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "sharp": "0.35.3",
    "tsx": "^4.23.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.1",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "20.20.2",
    "npm": "11.4.2"
  },
  "packageManager": "npm@11.4.2"
}
